{
  "id": "markdown",
  "name": "Markdown 美化",
  "version": "1.0.0",
  "publisher": "Infinite Studio",
  "description": "把 .md 文件排版成易读的文档：标题编号、提示块、带行号和复制按钮的代码块、任务进度、右侧大纲和阅读进度。支持阅读 / 分栏 / 源码三种模式，边写边看，滚动同步；墨夜、纸白、书卷、终端四套主题，可导出 HTML。",
  "category": "productivity",
  "homepage": "https://github.com/JunjiDuan/infinite-studio/tree/main/marketplace/plugins/markdown",
  "minStudio": "0.1.0",
  "icon": "icon.svg",
  "editor": {
    "entry": "index.html",
    "extensions": [".md", ".markdown", ".mdown", ".mkd"]
  },
  "newFile": {
    "label": "Markdown 文档",
    "extension": ".md",
    "template": "# 标题\n\n"
  }
}
