{
  "id": "html-preview",
  "name": "HTML 预览器",
  "version": "1.0.0",
  "publisher": "Infinite Studio",
  "description": "打开 .html 文件时直接显示成网页：本地的 CSS、JS、图片、字体自动加载，脚本照常运行。可切换预览 / 分栏 / 源码，分栏时边写边刷新；桌面、平板、手机尺寸预览，内置控制台显示 console 输出和报错；引用的文件改动后自动刷新，可导出单文件 HTML。",
  "category": "productivity",
  "homepage": "https://github.com/JunjiDuan/infinite-studio/tree/main/marketplace/plugins/html-preview",
  "minStudio": "0.1.0",
  "icon": "icon.svg",
  "permissions": ["network", "eval"],
  "editor": {
    "entry": "index.html",
    "extensions": [".html", ".htm", ".xhtml"]
  },
  "newFile": {
    "label": "HTML 网页",
    "extension": ".html",
    "template": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>新网页</title>\n  <style>\n    body { font-family: system-ui, sans-serif; margin: 40px; }\n  </style>\n</head>\n<body>\n  <h1>Hello</h1>\n\n  <script>\n    console.log('页面已加载')\n  </script>\n</body>\n</html>\n"
  }
}
