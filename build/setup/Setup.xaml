<!--
  Infinite Studio 安装 / 卸载界面（运行时用 XamlReader 加载，事件和文字在 Setup.cs 里设置）
  配色：暮 · 夜紫 + 蓝色强调色
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Infinite Studio"
        Width="820" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13">

  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#ECE7F2"/>
    <SolidColorBrush x:Key="Muted" Color="#9A95A6"/>
    <SolidColorBrush x:Key="Line" Color="#2C2A35"/>
    <SolidColorBrush x:Key="Panel" Color="#201E27"/>
    <SolidColorBrush x:Key="Accent" Color="#6E9BFF"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#8C7BFF" Offset="0"/>
      <GradientStop Color="#6E9BFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- 主按钮：蓝紫渐变 -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinWidth" Value="128"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="glow" CornerRadius="10" Background="{StaticResource AccentGradient}" Opacity="0.0">
                <Border.Effect>
                  <BlurEffect Radius="16"/>
                </Border.Effect>
              </Border>
              <Border x:Name="bd" CornerRadius="10" Background="{StaticResource AccentGradient}">
                <Border CornerRadius="10" BorderThickness="1">
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#55FFFFFF" Offset="0"/>
                      <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                </Border>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="glow" Property="Opacity" Value="0.55"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="glow" Property="Opacity" Value="0.45"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次要按钮：描边 -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="#0FFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1CFFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#6E9BFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 文字链接按钮 -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#8FB1FF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="Transparent" Padding="10,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#226E9BFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标题栏按钮 -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1CFFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 开关样式的复选框 -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="track" Width="34" Height="20" CornerRadius="10" Background="#2C2A35" BorderBrush="#3A3746" BorderThickness="1" VerticalAlignment="Center">
                <Ellipse x:Name="knob" Width="14" Height="14" Fill="#9A95A6" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="knobX" X="0"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentGradient}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="knobX" Storyboard.TargetProperty="X" To="14" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="knobX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="#6E9BFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 进度条：圆角轨道 + 渐变填充 + 流光 -->
    <Style x:Key="Progress" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="#2C2A35"/>
              <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left" Background="{StaticResource AccentGradient}" ClipToBounds="True">
                <Border.Effect>
                  <DropShadowEffect Color="#6E9BFF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <Rectangle x:Name="shine" Width="80" HorizontalAlignment="Left">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#00FFFFFF" Offset="0"/>
                      <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                      <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                  <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="shineX" X="-80"/>
                  </Rectangle.RenderTransform>
                  <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetName="shineX" Storyboard.TargetProperty="X" From="-80" To="520" Duration="0:0:1.6"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Rectangle.Triggers>
                </Rectangle>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>

  <!-- 外框留出阴影的位置 -->
  <Grid Margin="20">
    <Border x:Name="Frame" CornerRadius="18" BorderBrush="#33FFFFFF" BorderThickness="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#1D1A28" Offset="0"/>
          <GradientStop Color="#16151B" Offset="0.55"/>
          <GradientStop Color="#13121A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
      </Border.Effect>
    </Border>

    <!-- 背景光晕（裁剪在圆角内） -->
    <Canvas x:Name="Glows" ClipToBounds="True" IsHitTestVisible="False">
      <Ellipse x:Name="GlowA" Width="520" Height="520" Canvas.Left="-200" Canvas.Top="-240">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#665B3FC8" Offset="0"/>
            <GradientStop Color="#005B3FC8" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse x:Name="GlowB" Width="560" Height="560" Canvas.Left="420" Canvas.Top="160">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#446E9BFF" Offset="0"/>
            <GradientStop Color="#006E9BFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Canvas>

    <Grid x:Name="Content">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 左侧：品牌 -->
      <Border Grid.Column="0" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
        <Grid>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Grid Width="176" Height="96" HorizontalAlignment="Center">
              <!-- 无限符号：先描出来，再有一道流光不停地绕 -->
              <Path x:Name="InfBase" Stretch="Uniform" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M6.5 8.5c-1.9 0-3 1.4-3 3.5s1.1 3.5 3 3.5c3.5 0 7.5-7 11-7 1.9 0 3 1.4 3 3.5s-1.1 3.5-3 3.5c-3.5 0-7.5-7-11-7z">
                <Path.Stroke>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#A58BFF" Offset="0"/>
                    <GradientStop Color="#6E9BFF" Offset="1"/>
                  </LinearGradientBrush>
                </Path.Stroke>
                <Path.Effect>
                  <DropShadowEffect Color="#7F8CFF" BlurRadius="22" ShadowDepth="0" Opacity="0.7"/>
                </Path.Effect>
              </Path>
              <Path x:Name="InfShine" Stretch="Uniform" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="#F2F0FF" Opacity="0.9"
                    StrokeDashArray="3 57"
                    Data="M6.5 8.5c-1.9 0-3 1.4-3 3.5s1.1 3.5 3 3.5c3.5 0 7.5-7 11-7 1.9 0 3 1.4 3 3.5s-1.1 3.5-3 3.5c-3.5 0-7.5-7-11-7z">
                <Path.Effect>
                  <BlurEffect Radius="3"/>
                </Path.Effect>
              </Path>
            </Grid>
            <TextBlock Text="Infinite Studio" Margin="0,26,0,0" HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{StaticResource Text}"/>
            <TextBlock x:Name="Tagline" Text="无界工作室" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource Muted}"/>
            <Border Margin="0,18,0,0" HorizontalAlignment="Center" CornerRadius="11" Padding="10,3" Background="#1A6E9BFF" BorderBrush="#446E9BFF" BorderThickness="1">
              <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="11.5" Foreground="#A9C0FF" FontFamily="Cascadia Mono, Consolas"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="Copyright" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" FontSize="11" Foreground="#5F5B6B"/>
        </Grid>
      </Border>

      <!-- 右侧：步骤页 -->
      <Grid Grid.Column="1" Margin="44,40,40,32">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第 1 页：选项 -->
        <StackPanel x:Name="PageWelcome" Grid.Row="0">
          <TextBlock x:Name="WelcomeTitle" Style="{StaticResource H1}" Text="安装"/>
          <TextBlock x:Name="WelcomeText" Style="{StaticResource Body}" Margin="0,10,0,0" Text=""/>

          <Border x:Name="UpgradeNote" Margin="0,16,0,0" CornerRadius="10" Padding="12,9" Background="#146E9BFF" BorderBrush="#336E9BFF" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="UpgradeText" FontSize="12.5" Foreground="#C8D6FF" TextWrapping="Wrap" LineHeight="19"/>
          </Border>

          <StackPanel x:Name="LocationBlock" Margin="0,26,0,0">
            <TextBlock x:Name="LocationLabel" Style="{StaticResource Label}" Text="安装位置"/>
            <Border CornerRadius="10" Background="#0DFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Height="40">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PathText" Margin="14,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Text}"
                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="BrowseBtn" Grid.Column="1" Style="{StaticResource Link}" Margin="0,0,4,0" Height="30" Content="更改…"/>
              </Grid>
            </Border>
            <TextBlock x:Name="SpaceText" Margin="2,8,0,0" FontSize="11.5" Foreground="#6E6A7B"/>
          </StackPanel>

          <StackPanel x:Name="OptionsBlock" Margin="0,22,0,0">
            <CheckBox x:Name="DesktopCheck" Style="{StaticResource Switch}" IsChecked="True" Content="创建桌面快捷方式"/>
            <CheckBox x:Name="LaunchCheck" Style="{StaticResource Switch}" IsChecked="True" Margin="0,14,0,0" Content="安装完成后启动"/>
            <CheckBox x:Name="RemoveDataCheck" Style="{StaticResource Switch}" IsChecked="False" Margin="0,14,0,0" Content="同时删除个人设置与数据" Visibility="Collapsed"/>
          </StackPanel>
        </StackPanel>

        <!-- 第 2 页：进度 -->
        <StackPanel x:Name="PageProgress" Grid.Row="0" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,0,30">
          <TextBlock x:Name="ProgressTitle" Style="{StaticResource H1}" Text="正在安装"/>
          <TextBlock x:Name="ProgressText" Style="{StaticResource Body}" Margin="0,10,0,0"/>
          <Grid Margin="0,34,0,0">
            <TextBlock x:Name="PercentText" Text="0" FontSize="44" FontWeight="Light" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Display, Segoe UI"/>
          </Grid>
          <ProgressBar x:Name="Bar" Style="{StaticResource Progress}" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="0"/>
          <TextBlock x:Name="FileText" Margin="0,12,0,0" FontSize="11.5" Foreground="#6E6A7B" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"/>
        </StackPanel>

        <!-- 第 3 页：完成 / 出错 -->
        <StackPanel x:Name="PageDone" Grid.Row="0" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,0,30">
          <Grid x:Name="DoneBadge" Width="64" Height="64" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="DoneScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Ellipse x:Name="DoneCircle" Fill="{StaticResource AccentGradient}">
              <Ellipse.Effect>
                <DropShadowEffect Color="#6E9BFF" BlurRadius="26" ShadowDepth="0" Opacity="0.7"/>
              </Ellipse.Effect>
            </Ellipse>
            <Path x:Name="DoneMark" Data="M20 33 L28 41 L44 24" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  StrokeDashArray="9 9" StrokeDashOffset="9"/>
            <Path x:Name="ErrorMark" Data="M24 24 L40 40 M40 24 L24 40" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
          </Grid>
          <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" Margin="0,26,0,0" Text="安装完成"/>
          <TextBlock x:Name="DoneText" Style="{StaticResource Body}" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="SecondaryBtn" Style="{StaticResource Ghost}" Content="取消" Margin="0,0,10,0"/>
            <Button x:Name="PrimaryBtn" Style="{StaticResource Primary}" Content="安装" IsDefault="True"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <!-- 标题栏按钮 -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
      <Button x:Name="MinBtn" Style="{StaticResource Chrome}">
        <Path Data="M0 0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
      </Button>
      <Button x:Name="CloseBtn" Style="{StaticResource Chrome}">
        <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
      </Button>
    </StackPanel>

    <!-- 确认层：程序正在运行等 -->
    <Border x:Name="Overlay" CornerRadius="18" Background="#B30E0D12" Visibility="Collapsed">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" CornerRadius="14" Padding="26,24" Background="#201E27" BorderBrush="#3A3746" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock x:Name="OverlayTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
          <TextBlock x:Name="OverlayText" Style="{StaticResource Body}" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="OverlayNo" Style="{StaticResource Ghost}" Margin="0,0,10,0" Height="34"/>
            <Button x:Name="OverlayYes" Style="{StaticResource Primary}" Height="34" MinWidth="110"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
