{
  "name": "infinite-studio",
  "productName": "Infinite Studio",
  "version": "0.1.0",
  "description": "无界工作室 Infinite Studio — 极简、高度个性化的桌面 IDE",
  "author": "JunjiDuan",
  "homepage": "https://github.com/JunjiDuan/infinite-studio",
  "main": "out/main/index.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.cjs dev",
    "build": "node scripts/run.cjs build",
    "start": "node scripts/run.cjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/run-electron.cjs scripts/make-icon.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --x64 && node scripts/copy-installer.cjs"
  },
  "build": {
    "appId": "studio.infinite.ide",
    "productName": "Infinite Studio",
    "copyright": "Copyright © 2026 JunjiDuan",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@typescript/**"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/@typescript/typescript-win32-x64/lib",
          "to": "typescript-native"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Infinite Studio",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "artifactName": "InfiniteStudio-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/@typescript/typescript-darwin-${arch}/lib",
          "to": "typescript-native"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/@typescript/typescript-linux-${arch}/lib",
          "to": "typescript-native"
        }
      ]
    }
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "typescript": "^7.0.2",
    "ws": "^8.18.3"
  }
}
